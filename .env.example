# Client-side variables must use the WEBPACK_ prefix.
WEBPACK_APP_NAME=Avengers Store

# Base URL of the backend API. robots.txt points search engines at its
# /sitemap.xml.
WEBPACK_API_URL=http://localhost:8000/api/v1

# Public origin of the shop, used for canonical links and link previews.
# Defaults to the origin the page is opened on.
WEBPACK_SITE_URL=http://localhost:3000

# The admin dashboard (avengers-admin). Administrators get an "Admin" link in
# the account menu when set.
WEBPACK_ADMIN_URL=http://localhost:3001

# Webpack development server
HOST=localhost
PORT=3000
